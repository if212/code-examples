# Code-annotated template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# ONE snippet and what its marked lines do (playbooks/code.md section 3): the
# card on top, the callouts under it, two a row. A trailing comment `// <N>`
# (`# <N>`, `-- <N>`) becomes badge N, and callout N starts with "N. ".
# The code is verbatim from the user or the repo: 15 lines at most, 86
# characters a line with the marker, 2 to 6 markers.
grid-rows: 2
vertical-gap: 16

handler: "routes/orders.ts" {
  class: code-file
  src: |`ts
    app.post("/orders", async (req, res) => {
      const input = OrderSchema.parse(req.body); // <1>
      const key = req.get("Idempotency-Key"); // <2>
      const hit = await cache.get(key);
      if (hit) return res.status(200).json(hit);

      const order = await db.orders.insert(input); // <3>
      await cache.set(key, order, { ttl: 86400 });
      await events.publish("order.created", order); // <4>
      res.status(201).json(order);
    });
  `| {class: code}
}

# grid-rows before grid-columns, so the callouts read 1 2 / 3 4 (rows: half
# the callouts, rounded up). Two lines of about 30 characters each.
notes: {
  class: callouts
  grid-rows: 2
  grid-columns: 2
  n1: "1. Validates the body: a bad\nfield is a 400, before any write" {class: callout}
  n2: "2. The client's retry key:\na repeat gets the first reply" {class: callout}
  n3: "3. One INSERT; the order\nstarts as pending" {class: callout}
  n4: "4. Billing and email react\nto order.created" {class: callout}
}
