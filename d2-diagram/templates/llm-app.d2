# LLM app template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# Top-down: the user, the app that orchestrates every call (the focus), then
# everything the app calls, the vector index at the bottom where the online
# query and the offline indexing job meet (playbooks/architecture.md).
direction: down

# Geometry only: one width for the leaf row keeps it even and narrow.
classes: {
  w: {width: 120}
}

user: "Support agent\nSlack" {class: actor}

# The hub is as wide as the row it calls, so its four edges drop straight
# (at its natural width they jogged: 3 labels on bends).
app: "Assistant API\nFastAPI" {class: [service; focal]; width: 580}

# Row order = edge order below. The model is external unless self-hosted.
llm: "LLM\nClaude API" {class: [service; w; external]}
tools: Tools {
  class: zone
  # One row per tool: 5 tools under grid-rows 3 folded into 2 columns (11.3px).
  grid-rows: 3
  vertical-gap: 10
  horizontal-gap: 12
  tickets: "Ticket lookup" {class: [service; w]}
  orders: "Order status" {class: [service; w]}
  refunds: "Issue refund" {class: [service; w]}
}
memory: "Chat history\nRedis" {class: [datastore; w]}
# The retriever sits next to the indexing job: the index below spans both.
retriever: "Retriever\nhybrid search" {class: [service; w]}
index: Nightly indexing {
  class: zone
  docs: "Help center\nZendesk" {class: [service; w; external]}
  embed: "Embed job\nAirflow" {class: [service; w]}
}
vectors: "Vector index\npgvector" {class: datastore; width: 260}

# Every online call is a request and its answer: ONE <-> edge, "prompt /
# reply" (two opposite edges drew twice the lines and widened the canvas by
# 28px). The offline job writes one way (->). Tools are called by the app,
# never by the model. Main path flow, offline upsert async.
user <-> app: "question / answer" {class: flow}
app <-> llm: "prompt / reply" {class: flow}
app <-> tools: "call / result" {class: dep}
app <-> memory: history {class: dep}
app <-> retriever: "query / chunks" {class: flow}
retriever <-> vectors: "search / top-8" {class: flow}
index.docs -> index.embed: articles {class: dep}
index.embed -> vectors: upsert {class: async}
