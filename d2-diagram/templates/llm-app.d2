# LLM app template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# The app that orchestrates every call is the hub. Above it the conversation
# (the user, the model, the history), below it what it acts on (retrieval,
# tools); the vector index is the floor where the question and the nightly
# indexing meet (playbooks/architecture.md, LLM apps).
direction: down

# Geometry only: one leaf width; one height per row (a two-line cylinder
# needs 107, boxes beside it 96 so their sides end on its walls).
classes: {
  leaf: {width: 120}
  top: {height: 96}
}

# Key: one entry per encoding, in the request's words.
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    a <-> b: call and answer {class: dep}
    a -> b: nightly batch {class: async}
    x: external {class: [service; external]}
  }
}

# Row 1 sits above the hub because each of its edges is written `callee <-> app`.
user: "Support agent\nSlack" {class: [actor; tech; leaf; top]}
llm: "LLM\nClaude API" {class: [service; tech; leaf; top; external]}
memory: "Chat history\nRedis" {class: [datastore; tech; leaf]; height: 107}

# Focal because the request says "Highlight the Assistant API". It spans the
# callees above and below it, so every edge drops straight.
app: "Assistant API\nFastAPI" {class: [service; tech; focal]; width: 480}
# The nightly job's source: an external document store. The indexing path
# (source, job, index) forms its own column at the right.
docs: "Help center\nZendesk" {class: [datastore; tech; leaf; external]; height: 107}

retriever: "Retriever\nhybrid search" {class: [service; tech; leaf]}
# The tools in one row, gaps 12 (a grid's gaps are also its padding); a
# column of three made the diagram 120px taller and left a 192px hole.
tools: Tools {
  class: zone
  grid-rows: 1
  horizontal-gap: 12
  vertical-gap: 12
  tickets: Ticket lookup {class: [service; compact; leaf]}
  orders: Order status {class: [service; compact; leaf]}
  refunds: Issue refund {class: [service; compact; leaf]}
}
embed: "Embed job\nAirflow" {class: [service; tech; leaf]}
# As wide as the retriever-to-job span: both writers drop straight in.
vectors: "Vector index\npgvector" {class: [datastore; tech]; width: 680; height: 107}

# Each online call is ONE <-> edge, "request / answer"; one class for all
# (the request describes no single path). The app runs the tools, never the
# model; one edge into the Tools zone. The nightly job writes one way, async.
user <-> app: "question / answer" {class: dep}
llm <-> app: "prompt / reply" {class: dep}
memory <-> app: history {class: dep}
app <-> retriever: "query / chunks" {class: dep}
app <-> tools: "call / result" {class: dep}
retriever <-> vectors: "search / top 8" {class: dep}
docs -> embed: articles {class: async}
embed -> vectors: upsert {class: async}
