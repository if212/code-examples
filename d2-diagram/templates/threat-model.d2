# Threat model template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# DFD on the neutral theme: external entity = grey box (people and third
# parties alike), process = numbered circle (the ID the threats cite), data
# store = cylinder, trust boundary = dashed boundary, stacked in trust order
# from the internet down (playbooks/infrastructure.md). One look per element
# kind and one edge class: nothing needs a key.
direction: down

# Geometry only. A 110px circle holds 11 characters ("4. Payments", 8px to
# spare; at 100 it touched the rim). A store as wide as a circle keeps one
# column pitch: each store drops straight to its process and the Data
# boundary stands 18px out (120 beside 100: 46px).
# endlabel: a flow's label rides at its lower end, beside the line, in the
# band above the element below (mid-edge labels: 1029px tall, 0.47 aspect).
# Snowflake brand: ${sf-gray} in place of ${ink-600}.
classes: {
  proc: {shape: circle; width: 110; height: 110}
  store: {width: 110}
  endlabel: {target-arrowhead.style: {font-color: ${ink-600}; font-size: 14}}
}

# As wide as the DMZ below it: both flows drop straight and it sits centred
# over the boundary (at 300 it stood 15px to the right).
browser: Customer browser {class: [actor; compact]; width: 340}

# One chain of processes per column. Boundary titles of 9 characters at most.
dmz: DMZ {
  class: boundary
  login: "1. Login" {class: [service; proc]}
  checkout: "2. Checkout" {class: [service; proc]}
}
internal: Internal {
  class: boundary
  auth: "3. Auth" {class: [service; proc]}
  # Focal because the request says "the Payments process" (under review).
  pay: "4. Payments" {class: [service; proc; focal]}
}
data: Data {
  class: boundary
  users: Users DB {class: [datastore; store]}
  ledger: Payments DB {class: [datastore; store]}
}
# Beside the Data boundary; 120 wide, so the figure holds aspect 0.63 (0.58
# at its natural width).
stripe: Stripe {class: [actor; compact]; width: 120}

# Every flow "what\nprotocol"; the card token is named in its labels (no
# flow class: the token path forks from the browser beside the login flow
# and must turn to reach Stripe). Arrows follow the data: a read points
# from the store, written `process <- store` so the store stays below.
browser -> dmz.login: {class: [endlabel; dep]; target-arrowhead.label: "credentials\nHTTPS"}
browser -> dmz.checkout: {class: [endlabel; dep]; target-arrowhead.label: "card token\nHTTPS"}
dmz.login -> internal.auth: {class: [endlabel; dep]; target-arrowhead.label: "credentials\nmTLS"}
dmz.checkout -> internal.pay: {class: [endlabel; dep]; target-arrowhead.label: "card token\nmTLS"}
# `a <- b` puts target-arrowhead at b: this label sits by the store.
internal.auth <- data.users: {class: [endlabel; dep]; target-arrowhead.label: "password hash\nSQL"}
internal.pay -> data.ledger: {class: [endlabel; dep]; target-arrowhead.label: "charge id\nSQL"}
# Three short lines keep the label within Stripe's column (no void beside the stack).
internal.pay -> stripe: {class: [endlabel; dep]; target-arrowhead.label: "token,\namount\nHTTPS"}
