# Gitflow template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# Which branch is cut from where and merges back where (playbooks/change.md):
# one grid row per branch, one column per moment, time runs right. Each
# commit sits in a hidden slot (a grid stretches a bare dot into an oval).
# Branch and merge lines are diagonal by design: expect one W-diagonal-edge
# per cut or merge line, and nothing else. A line never crosses a commit.
classes: {
  frame: {label: ""; grid-rows: 5; grid-columns: 8; horizontal-gap: 16; vertical-gap: 16}
  # name width = the longest branch name + about 24
  name: {label: ""; width: 112; grid-rows: 1; horizontal-gap: 0; vertical-gap: 8; style.opacity: 0}
  slot: {label: ""; width: 60; height: 40; grid-rows: 1; horizontal-gap: 20; vertical-gap: 12; style.opacity: 0}
  tag: {width: 56; height: 28}
  # Branch names verbatim (caption would uppercase them), left-aligned in their cell.
  branch: {width: 112; height: 24; label.near: center-left; style: {fill: transparent; stroke: transparent; bold: false}}
  # Lines outweigh the dots: 2px lines, 14px commits.
  line: {style.stroke-width: 2}
  commit: {width: 14; height: 14}
}

# The frame's gaps are its padding and keep the tags off its border.
# grid-rows = 1 tag row + the branches; grid-columns = 1 name + the moments.
git: {
  class: [zone; frame]
  # Tags in their own row above main: a label on a dot would move the dot.
  t0: "" {class: tag; style.opacity: 0}
  t1: "1.0" {class: [service; tag]}
  t2: "" {class: tag; style.opacity: 0}
  t3: "" {class: tag; style.opacity: 0}
  t4: "" {class: tag; style.opacity: 0}
  t5: "1.1" {class: [service; tag]}
  t6: "" {class: tag; style.opacity: 0}
  t7: "1.1.1" {class: [service; tag]}
  m0: {class: name; n: main {class: [service; branch]}}
  m1: {class: slot; c: "" {class: [dot; commit]}}
  m2: {class: slot}
  m3: {class: slot}
  m4: {class: slot}
  m5: {class: slot; c: "" {class: [dot; commit]}}
  m6: {class: slot}
  m7: {class: slot; c: "" {class: [dot; commit]}}
  h0: {class: name; n: hotfix/1.1.1 {class: [service; branch]}}
  h1: {class: slot}
  h2: {class: slot}
  h3: {class: slot}
  h4: {class: slot}
  h5: {class: slot}
  h6: {class: slot; c: "" {class: [dot; commit]}}
  h7: {class: slot}
  r0: {class: name; n: release/1.1 {class: [service; branch]}}
  r1: {class: slot}
  r2: {class: slot}
  r3: {class: slot; c: "" {class: [dot; commit]}}
  r4: {class: slot; c: "" {class: [dot; commit]}}
  r5: {class: slot}
  r6: {class: slot}
  r7: {class: slot}
  # The working branch the request names ("we work on develop") is flow.
  d0: {class: name; n: develop {class: [service; branch]}}
  d1: {class: slot; c: "" {class: [dot; commit]}}
  d2: {class: slot; c: "" {class: [dot; commit]}}
  d3: {class: slot}
  d4: {class: slot; c: "" {class: [dot; commit]}}
  d5: {class: slot; c: "" {class: [dot; commit]}}
  d6: {class: slot}
  d7: {class: slot; c: "" {class: [dot; commit]}}
}

# Lines are `--` (no arrowheads): branch lines first, then cuts and merges.
git.d1.c -- git.d2.c -- git.d4.c -- git.d5.c -- git.d7.c: {class: flow}
git.m1.c -- git.m5.c -- git.m7.c: {class: [dep; line]}
git.r3.c -- git.r4.c: {class: [dep; line]}
git.d2.c -- git.r3.c: {class: [dep; line]}
git.r4.c -- git.m5.c: {class: [dep; line]}
git.r4.c -- git.d5.c: {class: [dep; line]}
git.m5.c -- git.h6.c: {class: [dep; line]}
git.h6.c -- git.m7.c: {class: [dep; line]}
git.h6.c -- git.d7.c: {class: [dep; line]}
