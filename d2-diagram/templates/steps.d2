# Steps template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
# The output is a FOLDER: d2check writes <target>/index.svg + <target>/1.svg..3.svg.
...@neutral-theme
direction: down

# Base board: every node AND every edge, edges hidden (opacity 0). Every board
# then has the same graph, so the same layout: nothing jumps between steps.
browser: Browser {class: actor}
gateway: API gateway {class: service}
api: Orders API {class: focal}
db: Orders DB {class: datastore}

browser -> gateway: 1. GET /orders {class: dep; style.opacity: 0}
gateway -> api: 2. forward, token valid {class: dep; style.opacity: 0}
api -> db: 3. SELECT open orders {class: dep; style.opacity: 0}

# Each step inherits all earlier ones: show its hop as flow, grey the last one.

steps: {
  "1": {
    (browser -> gateway)[0]: {class: flow; style.opacity: 1}
  }
  "2": {
    (browser -> gateway)[0].class: dep
    (gateway -> api)[0]: {class: flow; style.opacity: 1}
  }
  "3": {
    (gateway -> api)[0].class: dep
    (api -> db)[0]: {class: flow; style.opacity: 1}
  }
}
