# UML class template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme
# Down, with parents and wholes on top: `Parent <- Child` keeps the parent above.
direction: down

# One width per row. ELK centres a class on its edges, so a class spans the
# classes under it exactly only when they share one width: Order is as wide
# as the two under it (300 + 20 + 300) and no hole opens beside it.
classes: {
  row2: {width: 300}
  row3: {width: 240}
}

# Class shapes take no role class (stroke paints the body): the globs at the
# end style them. Quote any member holding ":" or "#": "+pay(m: Method)": Receipt.
# The class the request focuses on: focal-solid, body reset to white.
Order: {
  shape: class
  class: focal-solid
  style.stroke: ${paper}
  width: 620
  +id: UUID
  +total(): Money
  +checkout(): Receipt
}
LineItem: {
  shape: class
  class: row2
  +sku: string
  +qty: int
}
PaymentMethod: "<<interface>>\nPaymentMethod" {
  shape: class
  class: row2
  +charge(amount): Receipt
}
# An implementation lists its own members; the realization says it has charge().
CardPayment: {
  shape: class
  class: row3
  -token: string
}
Wallet: {
  shape: class
  class: row3
  -balance: Money
}

# Composition: filled diamond on the whole. Multiplicity: arrowhead label, on
# a named edge only (an unnamed one is 40px long: the label sits by both ends).
Order <- LineItem: contains {
  class: dep
  source-arrowhead: {shape: diamond; style.filled: true}
  target-arrowhead.label: "1..*"
}
Order -> PaymentMethod: pays with {
  class: dep
  target-arrowhead.label: "0..1"
}
# Realization: dashed line, hollow triangle (solid line = inheritance).
PaymentMethod <- CardPayment: {
  class: dep
  style.stroke-dash: 4
  source-arrowhead: {shape: triangle; style.filled: false}
}
PaymentMethod <- Wallet: {
  class: dep
  style.stroke-dash: 4
  source-arrowhead: {shape: triangle; style.filled: false}
}

# 16px members, 1px outline, square corners, slate headers except the focus.
*: {&shape: class; style: {font-size: 16; stroke-width: 1; border-radius: 0}}
*: {&shape: class; !&class: focal-solid; style.fill: ${ink-500}}
