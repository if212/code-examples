# Network template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# Arrows = allowed traffic, from the side that opens the connection
# (playbooks/infrastructure.md). One zone per subnet, AZ and CIDR in its
# title; no AZ frame (one more nesting level, ~100px wider).
direction: down

# Geometry only. One size for every node, so the AZ columns line up. port:
# the port rides at the arrow's tail, beside the line (a mid-edge label
# adds 59px per rank; 3 of them broke the 900px budget).
# Snowflake brand: ${sf-gray} in place of ${ink-600}.
classes: {
  n: {width: 96}
  port: {source-arrowhead.style: {font-color: ${ink-600}; font-size: 14}}
}

vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    a -> b: allowed traffic {class: dep}
    a -> b: egress {class: secondary}
  }
}

users: Internet users {class: [actor; compact]}
vpc: "VPC 10.0.0.0/16, us-east-1" {
  class: boundary
  # As wide as the columns it serves: its four edges drop straight.
  igw: Internet gateway {class: [service; compact]; width: 520}
  # Both AZs wired alike, AZ b mirrored: ingress runs down the outer columns.
  # Subnet titles centred between the two columns' edges (top-left, the edge
  # into the left node touched a 12-character CIDR line).
  pub_a: "Public 1a\n10.0.1.0/24" {
    class: zone
    label.near: top-center
    alb: "ALB\nnode 1a" {class: [service; tech; compact; n]}
    nat: "NAT\ngateway 1a" {class: [service; tech; compact; n]}
  }
  pub_b: "Public 1b\n10.0.2.0/24" {
    class: zone
    label.near: top-center
    nat: "NAT\ngateway 1b" {class: [service; tech; compact; n]}
    alb: "ALB\nnode 1b" {class: [service; tech; compact; n]}
  }
  app_a: "Private 1a\n10.0.11.0/24" {
    class: zone
    label.near: top-center
    api: "orders-api\nFargate 1a" {class: [service; tech; compact; n]}
    worker: "worker\nFargate 1a" {class: [service; tech; compact; n]}
  }
  app_b: "Private 1b\n10.0.12.0/24" {
    class: zone
    label.near: top-center
    worker: "worker\nFargate 1b" {class: [service; tech; compact; n]}
    api: "orders-api\nFargate 1b" {class: [service; tech; compact; n]}
  }
  # A Multi-AZ service is ONE node below both AZs (one endpoint), its data
  # subnets in the label, as wide as the columns it serves.
  db: "Orders DB, RDS Postgres Multi-AZ\ndata subnets 10.0.21.0/24, 10.0.22.0/24" {class: [datastore; tech]; width: 560; height: 107}
}

# The ingress path forks into two AZ peers, so no flow (focus: none). Egress
# is secondary, written `upper <- lower` (as `->` it crossed twice).
users -> vpc.igw: {class: [port; dep]; source-arrowhead.label: "HTTPS :443"}
vpc.igw -> vpc.pub_a.alb: {class: dep}
vpc.igw -> vpc.pub_b.alb: {class: dep}
vpc.pub_a.alb -> vpc.app_a.api: {class: [port; dep]; source-arrowhead.label: ":8080"}
vpc.pub_b.alb -> vpc.app_b.api: {class: [port; dep]; source-arrowhead.label: ":8080"}
vpc.app_a.api -> vpc.db: {class: [port; dep]; source-arrowhead.label: ":5432"}
vpc.app_b.api -> vpc.db: {class: [port; dep]; source-arrowhead.label: ":5432"}
vpc.pub_a.nat <- vpc.app_a.worker: {class: secondary}
vpc.pub_b.nat <- vpc.app_b.worker: {class: secondary}
vpc.igw <- vpc.pub_a.nat: {class: secondary}
vpc.igw <- vpc.pub_b.nat: {class: secondary}
