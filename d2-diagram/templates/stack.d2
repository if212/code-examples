# Layer stack template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# One grid row: the stack of layers, then one tall bar per cross-cutting
# concern. Cells of a row share its height, so each bar spans the stack.
# Top = closest to the user. No edges: position is the relation
# (playbooks/hierarchy.md).
grid-rows: 1
horizontal-gap: 12

# Geometry only. A grid's gaps are also its padding (default 60px: bands
# 180px tall). Every band is 492px inside: part width = (492 - (n-1)*12)/n,
# so 4 parts: 114, 3: 156, 2: 240, and the band edges line up exactly
# (scale 0.95; 1.00 needs parts under 106px, narrower than "LLM gateway").
# Bars: a centred title of about 10 characters (MONITORING: 98 of 112px).
classes: {
  layer: {grid-rows: 1; horizontal-gap: 12; vertical-gap: 12}
  p4: {width: 114; height: 60}
  p3: {width: 156; height: 60}
  bar: {width: 112; label.near: center-center}
}

# The stack is one untitled zone, as tall as the bars beside it.
# grid-rows = the band count: 5 bands under 4 wrapped into 2 columns (8.4px).
stack: "" {
  class: zone
  grid-rows: 4
  vertical-gap: 12
  horizontal-gap: 12

  apps: Apps {
    class: [zone; layer]
    bot: "Support bot\nSlack" {class: [service; tech; p3]}
    copilot: "Sales copilot\nSalesforce" {class: [service; tech; p3]}
    bi: "Dashboards\nLooker" {class: [service; tech; p3]}
  }
  # Focal because the request says "Highlight the LLM gateway"; its band
  # stays a plain zone (a focal part never sits on the blue panel).
  ai: ML and AI {
    class: [zone; layer]
    gateway: "LLM gateway\nLiteLLM" {class: [service; tech; p4; focal]}
    search: "Vectors\npgvector" {class: [service; tech; p4]}
    features: "Features\nFeast" {class: [service; tech; p4]}
    registry: "Models\nMLflow" {class: [service; tech; p4]}
  }
  data: Data {
    class: [zone; layer]
    ingest: "Ingestion\nFivetran" {class: [service; tech; p4]}
    transform: "Transform\ndbt" {class: [service; tech; p4]}
    warehouse: "Warehouse\nSnowflake" {class: [service; tech; p4]}
    schedule: "Scheduling\nAirflow" {class: [service; tech; p4]}
  }
  infra: Infrastructure {
    class: [zone; layer]
    cloud: "Cloud\nAWS" {class: [service; tech; p3]}
    compute: "Compute\nEKS" {class: [service; tech; p3]}
    iac: "Provisioning\nTerraform" {class: [service; tech; p3]}
  }
}

security: Security {class: [zone; bar]}
monitoring: Monitoring {class: [zone; bar]}
