# ERD template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme
direction: right
# Crow's-foot key, one symbol per line, in the relationships' class. The key
# draws lines at half scale, so 4px shows at the 2px of the relationships.
# d2check spaces tables 72px apart so the two ends of a relationship stay
# apart, and moves the key under the diagram when it does not fit beside it.
vars: {
  d2-legend: {
    a: {class: ghost}
    b: {class: ghost}
    a -> b: exactly one {class: dep; style.stroke-width: 4; target-arrowhead.shape: cf-one-required}
    a -> b: zero or one {class: dep; style.stroke-width: 4; target-arrowhead.shape: cf-one}
    a -> b: one or many {class: dep; style.stroke-width: 4; target-arrowhead.shape: cf-many-required}
    a -> b: zero or many {class: dep; style.stroke-width: 4; target-arrowhead.shape: cf-many}
  }
}

# Tables take no node class (on sql_table, stroke paints the body); the globs
# at the end style them. A table the request highlights gets class:
# focal-solid and style.stroke: ${paper} (blue header, white body).
events: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  name: text
  starts_at: timestamptz
}
attendees: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  email: text {constraint: unique}
}
sessions: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  event_id: uuid {constraint: foreign_key}
  title: text
}
# Short constraint text keeps a table narrow: "null" marks a nullable FK.
tickets: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  event_id: uuid {constraint: foreign_key}
  attendee_id: uuid {constraint: [foreign_key; "null"]}
  status: ticket_status
}
status_values: "ticket_status values:\navailable, sold, refunded" {class: [note; compact]}

# Parent PK first (parents land on the left). <-> draws both ends.
# NOT NULL FK: cf-one-required at the parent; nullable FK: cf-one.
events.id <-> sessions.event_id: {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-many-required}
events.id <-> tickets.event_id: {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-many}
attendees.id <-> tickets.attendee_id: {source-arrowhead.shape: cf-one; target-arrowhead.shape: cf-many}

# Globs come after what they style: 16px rows, square corners, slate headers
# except a focus table; relationships dep at 2px (1px thins the crow's feet).
*: {&shape: sql_table; style: {font-size: 16; stroke-width: 1; border-radius: 0}}
*: {&shape: sql_table; !&class: focal-solid; style.fill: ${ink-500}}
(** <-> **)[*]: {class: dep; style.stroke-width: 2}
