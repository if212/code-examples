# Walkthrough template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# ONE request through the real parts (C4 dynamic): the architecture stays,
# the path is flow, numbered 1..N in path order (playbooks/change.md).
direction: down

# Every box compact, "Name\nTechnology" with tech (line 2 small and slate).
# One width per row: the path cards above the zone, the services, the stores
# (a cylinder needs 108 for two lines).
classes: {
  path: {width: 280}
  svc: {width: 150}
  store: {width: 150; height: 108}
}

browser: Browser {class: [actor; compact; path]}
cdn: "CDN\nCloudFront" {class: [service; compact; tech; path]}
# The reply as a note beside the part it is about, not an upward edge (that
# detours round everything). A hidden edge from the browser puts it in the
# CDN's row; a ghost on the other side keeps hop 1 straight.
reply: "5. The reply retraces the path;\nCloudFront caches it 60 s" {class: [note; compact]}
g0: "" {class: ghost}
aws: AWS VPC {
  class: zone
  # The gateway spans the services it routes to (3 x 150 + 2 x 40): every
  # route drops straight, and the path is the middle one.
  gw: "API gateway\nKong" {class: [service; compact; tech]; width: 530}
  # Off the path: muted, declared left to right (off, path, off).
  orders: "Orders API\nGo" {class: [muted; compact; tech; svc]}
  catalog: "Catalog API\nGo" {class: [service; compact; tech; svc; focal]}
  cart: "Cart API\nGo" {class: [muted; compact; tech; svc]}
  ordersdb: "Orders DB\nPostgres" {class: [datastore; tech; store; muted]}
  catalogdb: "Catalog DB\nPostgres" {class: [datastore; tech; store]}
  cartdb: "Cart DB\nPostgres" {class: [datastore; tech; store; muted]}
}

# Hops in path order, "N. verb object" (22 characters at most). Edges off the
# path are secondary and labelled too: a label takes a rank, so labelled and
# bare edges out of one row would end on different rows.
browser -> g0: "1. GET /products/42" {class: ghost}
browser -> cdn: "1. GET /products/42" {class: flow}
browser -> reply: "1. GET /products/42" {class: ghost}
cdn -> aws.gw: "2. cache miss" {class: flow}
aws.gw -> aws.orders: "/orders" {class: secondary}
aws.gw -> aws.catalog: "3. route /products" {class: flow}
aws.gw -> aws.cart: "/cart" {class: secondary}
aws.orders -> aws.ordersdb: SQL {class: secondary}
aws.catalog -> aws.catalogdb: "4. SELECT product 42" {class: flow}
aws.cart -> aws.cartdb: SQL {class: secondary}

# The key: the parts off the path, the path, the routes off it.
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    m: off the path (gray label) {class: [muted; compact; svc]}
    a -> b: the path {class: flow}
    a -> b: other routes {class: secondary}
  }
}
