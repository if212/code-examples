# Pipeline template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# Doc column: stage zones stacked down, one zone per stage the request names;
# the warehouse is ONE zone holding its layers (playbooks/pipeline.md).
direction: down

# Geometry only. A box beside a cylinder is 10px shorter (its sides end on
# the walls). Layers as wide as the rows allow: a narrow column left
# 170px voids beside it (I-sparse). hop: a tool's name rides at the end of
# the hop it performs, beside the line (mid-edge labels cost ~60px a rank).
# Snowflake brand: ${sf-gray} in place of ${ink-600}.
classes: {
  src: {width: 130; height: 96}
  out: {width: 130}
  layer: {width: 230; height: 90}
  hop: {source-arrowhead.style: {font-color: ${ink-600}; font-size: 14}; target-arrowhead.style: {font-color: ${ink-600}; font-size: 14}}
}

# Co-equal sources: no main source, one look for all three. "Role\nTool".
sources: Sources {
  class: zone
  pg: "App DB\nPostgres" {class: [datastore; tech]; width: 130; height: 106}
  stripe: "Payments\nStripe API" {class: [service; tech; src]}
  events: "Clickstream\nSegment" {class: [service; tech; src]}
}
# The platform is the zone title; each layer a cylinder of one line (90 is the
# least that clears its rims). Focal because the request says "Highlight MARTS".
wh: Snowflake {
  class: zone
  raw: RAW {class: [datastore; layer]}
  stg: STAGING {class: [datastore; layer]}
  marts: MARTS {class: [datastore; layer; focal]}
}
consumers: Consumers {
  class: zone
  bi: "Dashboards\nLooker" {class: [service; tech; compact; out]}
  ml: "Features\nFeast" {class: [service; tech; compact; out]}
  retl: "Reverse ETL\nHightouch" {class: [service; tech; compact; out]}
}

# A merge into one node and a fan-out to a whole stage are ONE edge to the
# zone (the brief still lists every edge). Fivetran and dbt are the hops
# they perform, never nodes of their own. One edge class: no key needed.
sources -> wh.raw: {class: [hop; dep]; source-arrowhead.label: Fivetran}
wh.raw -> wh.stg: {class: [hop; dep]; target-arrowhead.label: dbt}
wh.stg -> wh.marts: {class: [hop; dep]; target-arrowhead.label: dbt}
wh.marts -> consumers: {class: dep}
