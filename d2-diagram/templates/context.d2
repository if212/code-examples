# C4 context template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# One system as ONE box: the people who use it above, the systems it calls
# below, so every arrow points down. Its insides are c4.d2 (playbooks/architecture.md).
direction: down

# Geometry only: c4-person sizes itself by its label (heads unequal), so
# one class evens the people; one box size for every neighbour system.
classes: {
  person: {shape: c4-person; width: 120; height: 90}
  box: {width: 160; height: 56}
}

# C4 names itself: a title, and a key of what each look means.
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    s: system in scope {class: [service; box; focal]}
    x: external system {class: [service; external]}
    a -> b: relationship {class: dep}
    a -> b: nightly batch {class: async}
  }
}
title: "System context: Online shop" {class: title}

customer: "Customer\n[Person]" {class: [actor; tech; person]}
staff: "Staff\n[Person]" {class: [actor; tech; person]}

# The one system in scope (focal: "Highlight the shop") spans the row below
# it, so all four edges drop straight (at 480px the people's labels collided).
shop: "Online shop\n[Software System]" {class: [service; tech; box; focal]; width: 700}

# Neighbours: one row, in the order of their edges; 4 fit the column. Systems
# that call this one join the people's row. More below: one box per kind
# ("Payments\n[Software System]" for Stripe and PayPal).
stripe: "Stripe\n[Software System]" {class: [service; tech; box; external]}
sendgrid: "SendGrid\n[Software System]" {class: [service; tech; box; external]}
easypost: "EasyPost\n[Software System]" {class: [service; tech; box; external]}
erp: "ERP\n[Software System]" {class: [service; tech; box; external]}

# "Verb object [protocol]", from the side that starts the call; the edge
# says what the neighbour does, so the boxes need no third line. People the
# request lists together share one class; the nightly export is async.
customer -> shop: "Places orders [HTTPS]" {class: dep}
staff -> shop: "Manages the catalog [HTTPS]" {class: dep}
shop -> stripe: "Charges cards [HTTPS]" {class: dep}
shop -> sendgrid: "Sends receipts [HTTPS]" {class: dep}
shop -> easypost: "Buys labels [HTTPS]" {class: dep}
shop -> erp: "Exports orders nightly [SFTP]" {class: async}
