# Architecture template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# Doc column: top-down tiers, one row each (playbooks/architecture.md).
direction: down

# Geometry only. One width for the callers and the tier below them, so each
# lower node sits straight under its caller (no doglegs). A box beside a
# cylinder is 11px shorter: its sides end where the cylinder's walls do.
classes: {
  tier: {width: 140}
  lower: {height: 96}
}

# Key: one entry per encoding the diagram uses, in the request's words.
# d2check restyles and places it (here: under the diagram).
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    a -> b: call {class: dep}
    a -> b: event {class: async}
    ext: third party {class: [service; external]}
  }
}

web: Web client {class: [actor; compact; tier]}
mobile: Mobile client {class: [actor; compact; tier]}
# The fan-out node spans the three services it routes to: straight edges.
gateway: "API gateway\nKong" {class: [service; tech]; width: 400}
# The broker sits in the top row, over its producer and its consumer (a
# consumer the gateway also calls: see playbooks/architecture.md rule 2).
events: "Order events\nKafka" {class: [queue; tech]; width: 180}

# Services in the order of the tier below them, the consumer last. The
# request names no languages, so no tech lines (never guess one).
services: Services {
  class: zone
  payments: Payments {class: [service; compact; tier]}
  catalog: Catalog {class: [service; compact; tier]}
  orders: Orders {class: [service; compact; tier; focal]}
  notify: Notifications {class: [service; compact; tier]}
}

# ONE lower zone in the callers' order, third parties at the ends; a store
# two services use spans both (2 x 140 + the 20px gap: each node then sits
# centred under its caller). Title at the bottom: every edge enters from
# above. width = the Services zone's (720), so the zones share both edges.
data: Data and third parties {
  class: zone
  label.near: bottom-left
  width: 720
  stripe: "Stripe\ncard payments" {class: [service; tech; tier; lower; external]}
  db: "Shop DB\nPostgres" {class: [datastore; tech]; width: 300; height: 107}
  sendgrid: "SendGrid\nemail" {class: [service; tech; tier; lower; external]}
}

# Every edge of a kind carries the request's verb; the key names the plain
# arrow. "Highlight Orders" names a node, not a path: no flow edges. The
# broker is written first on both of its edges, so ELK ranks it above them.
web -> gateway: {class: dep}
mobile -> gateway: {class: dep}
gateway -> services.payments: REST {class: dep}
gateway -> services.catalog: REST {class: dep}
gateway -> services.orders: REST {class: dep}
events <- services.orders: publishes {class: async}
events -> services.notify: consumes {class: async}
services.payments -> data.stripe: charges {class: dep}
services.catalog -> data.db: uses {class: dep}
services.orders -> data.db: uses {class: dep}
services.notify -> data.sendgrid: sends email {class: dep}
