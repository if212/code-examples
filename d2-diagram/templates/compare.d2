# Compare template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme

# Before | after, key below: grid-rows first (then cells fill row by row).
# Each panel is a grid cell laid out on its own (a cell keeps its own
# direction). No edge crosses the panels (playbooks/change.md).
grid-rows: 2
grid-columns: 2
horizontal-gap: 16
vertical-gap: 16

# One width for every box, one height for the bottom row (a cylinder and a
# box side by side): both panels come out the same size.
classes: {
  box: {width: 120}
  low: {height: 108}
}

# Same keys, same order on both sides, so shared parts land in the same
# place; a replacement takes the slot of the part it replaces. An edge on
# one side only gets a hidden twin on the other: same graph, same layout.
# Removed parts are muted and appear on the before side only.
before: "Before: server sessions" {
  class: zone
  direction: down
  web: "Web app\nReact" {class: [actor; tech; box]}
  api: "Shop API\nRails" {class: [service; tech; box]}
  db: "Users DB\nPostgres" {class: [datastore; tech; box; low]}
  sessions: "Sessions\nMemcached" {class: [datastore; tech; box; low; muted]}
  web -> api: {class: dep}
  api -> db: {class: dep}
  api -> sessions: {class: dep}
  # hidden twin of the after side's web -> idp
  web -> sessions: {class: dep; style.opacity: 0}
}

# Status is the class: added success, removed muted, changed focal. Both
# panels are plain zones: a focal box on a blue panel would not stand out.
after: "After: OIDC tokens" {
  class: zone
  direction: down
  web: "Web app\nReact" {class: [actor; tech; box]}
  api: "Shop API\nJWT auth" {class: [service; tech; box; focal]}
  db: "Users DB\nPostgres" {class: [datastore; tech; box; low]}
  idp: "Login\nAuth0" {class: [service; tech; box; low; success]}
  web -> api: {class: dep}
  api -> db: {class: dep}
  api -> idp: {class: dep}
  web -> idp: {class: dep}
}

# The key: chips in the status classes (a legend swatch cannot show text weight).
key: {
  class: key
  added: Added {class: [service; chip; success]}
  removed: Removed {class: [muted; chip]}
  changed: Changed {class: [service; chip; focal]}
}
