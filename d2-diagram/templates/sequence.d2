# Sequence template. Write D2W/<name>.brief first (workflows/brief.md); reuse its keys.
...@neutral-theme
shape: sequence_diagram

# One width for every participant: the header row comes out even.
classes: {box: {width: 120}}

# Participants first, in reading order: declaration order = column order. All
# are actor boxes; the one the request focuses on adds focal (blue box and
# lifeline). Third parties too: the label names them.
browser: Browser {class: [actor; box]}
api: Orders API {class: [actor; box; focal]}
db: Orders DB {class: [actor; box]}
psp: Stripe {class: [actor; box]}

# One message per line, numbered, 40 characters at most, parameters in
# parentheses. A message to a child key (db.a) draws an activation bar: a bar
# on every participant that does work, one key per activation.
browser -> api.t: "1. POST /orders" {class: dep}
api.t -> db.a: "2. INSERT order (pending)" {class: dep}
api.t -> psp.a: "3. POST /charges" {class: dep}

# alt: a zone titled with its question, one nested zone per outcome: success
# zone-green, failure zone-amber. Every outcome touches the same participants
# and restarts at the same number. Guards stay as written: text-transform
# none, regular weight. Returns: secondary + dash; error returns: failure.
alt: "alt: charge result" {
  class: zone
  style: {text-transform: none}
  ok: "[approved]" {
    class: zone-green
    style: {text-transform: none; bold: false}
    api.t -> db.b: "4. UPDATE order (paid)" {class: dep}
    api.t -> browser: "5. 201 Created" {class: secondary; style.stroke-dash: 3}
  }
  declined: "[declined]" {
    class: zone-amber
    style: {text-transform: none; bold: false}
    api.t -> db.c: "4. UPDATE order (failed)" {class: dep}
    api.t -> browser: "5. 402 Payment Required" {class: failure}
  }
}
