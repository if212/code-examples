# Before: the nullable FK is drawn cf-one-required ("exactly one"): wrong cardinality.
# brief: erd.brief
...@neutral-theme
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    a -> b: exactly one {style.stroke-width: 4; target-arrowhead.shape: cf-one-required}
    a -> b: zero or one {style.stroke-width: 4; target-arrowhead.shape: cf-one}
    a -> b: one or many {style.stroke-width: 4; target-arrowhead.shape: cf-many-required}
    a -> b: zero or many {style.stroke-width: 4; target-arrowhead.shape: cf-many}
  }
}
direction: right
users: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  email: text {constraint: unique}
}
tasks: {
  shape: sql_table
  class: focal-solid
  style.stroke: ${paper}
  id: uuid {constraint: primary_key}
  title: text
  assignee_id: uuid {constraint: [foreign_key; nullable]}
}
# nullable FK: cf-one (zero or one) at the parent end
users.id <-> tasks.assignee_id: {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-many}
*: {&shape: sql_table; style: {font-size: 16; stroke-width: 1; border-radius: 0}}
*: {&shape: sql_table; !&class: focal-solid; style.fill: ${ink-600}}
(** <-> **)[*]: {class: dep; style.stroke-width: 2}
