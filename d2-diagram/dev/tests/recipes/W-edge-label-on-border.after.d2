# After: the port moves into the target's label; edges that cross borders stay unlabelled.
# allow: I-sparse
...@neutral-theme
direction: down
users: Shoppers {class: actor}
alb: "Load balancer\nAWS ALB" {class: service}
eks: EKS cluster {
  class: zone
  shop: namespace shop {
    class: zone-blue
    api: "orders-api :8080\n3 pods" {class: [service; focal]; style.multiple: true}
    web: "storefront :8080\n3 pods" {class: service; style.multiple: true}
  }
}
users -> alb: "HTTPS :443" {class: flow}
alb -> eks.shop.api: {class: flow}
alb -> eks.shop.web: {class: dep}
