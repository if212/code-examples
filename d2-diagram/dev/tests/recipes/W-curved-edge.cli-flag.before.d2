# Before: the theme pins ELK, but a -l dagre flag on the command line overrides it.
# d2: -l dagre
...@neutral-theme
direction: down
web: Web app {class: actor}
api: Orders API {class: service}
db: "Orders DB\nPostgres" {class: datastore}
web -> api: HTTPS {class: dep}
api -> db: writes {class: dep}
