# Before: container-to-container edges stand in for the real ones: they meet the zones'
# middles and lose the endpoints.
...@neutral-theme
direction: right
src: Sources {class: zone; app: "App DB\nPostgres" {class: datastore}}
ingest: Ingest {class: zone; fivetran: Fivetran {class: service}}
wh: Snowflake {class: zone; raw: RAW {class: [datastore; focal]}}
src -> ingest: {class: dep}
ingest -> wh: {class: dep}
