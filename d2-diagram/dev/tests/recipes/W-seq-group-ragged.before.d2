# Before: phase groups span different participants, so their bands start and end at
# different x.
...@neutral-theme
shape: sequence_diagram
classes: {p: {width: 130}}
user: User {class: [actor; p]}
app: Mobile app {class: [actor; p]}
auth: Auth server {class: [actor; p]}
api: Items API {class: [actor; p]}
login: Login {
  class: zone
  user -> app: "1. open app" {class: dep}
  app -> auth: "2. authorize" {class: dep}
  auth -> app: "3. token" {class: secondary}
}
fetch: Fetch data {
  class: zone
  app -> api: "4. GET /items" {class: dep}
  api -> app: "5. items" {class: secondary}
}
