# Before: two icon families in one diagram (lucide line icons plus a logos brand icon).
# brief: arch.brief
...@neutral-theme
direction: down
web: Web app {class: actor; icon: icons/app-window.svg}
api: Orders API {class: [service; focal]; icon: icons/server.svg}
db: "Orders DB\nPostgres" {class: datastore}
events: "Order events\nKafka" {class: queue}
mailer: Mailer {class: service; icon: logos-sendgrid.svg}
web -> api: HTTPS {class: flow}
api -> db: {class: dep}
api -> events: {class: async}
events -> mailer: {class: async}
