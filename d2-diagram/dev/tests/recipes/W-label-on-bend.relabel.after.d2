# After: each exit label is the event (cancel, refund, return): the post step moves it onto
# the first straight run from the state.
...@neutral-theme
direction: down
classes: {s: {width: 140}}
start: "" {class: dot}
pending: Pending {class: [state; compact; s]}
paid: Paid {class: [state; compact; s]}
shipped: Shipped {class: [state; compact; s]}
delivered: Delivered {class: [success; compact; s; terminal]; style.double-border: true}
cancelled: Cancelled {class: [compact; s; terminal]; style.double-border: true}
refunded: Refunded {class: [compact; s; terminal]; style.double-border: true}
g1: "" {class: ghost}
g2: "" {class: ghost}
g3: "" {class: ghost}
start -> pending: {class: flow}
pending -> g1: pay {class: ghost}
pending -> paid: pay {class: flow}
pending -> cancelled: cancel {class: dep}
paid -> g2: ship {class: ghost}
paid -> shipped: ship {class: flow}
paid -> refunded: refund {class: dep}
shipped -> g3: deliver {class: ghost}
shipped -> delivered: deliver {class: flow}
shipped -> refunded: return {class: dep}
