# After: the entry point is as wide as the tier it feeds: no empty corner.
...@neutral-theme
direction: down
classes: {col: {width: 140}; low: {width: 140; height: 92}}
web: Web app {class: actor}
gateway: API gateway {class: service; width: 620}
services: Services {
  class: zone
  catalog: Catalog {class: [service; col]}
  orders: Orders {class: [service; col]}
  notify: Notifications {class: [service; col]}
  payments: Payments {class: [service; col]}
}
data: Data {
  class: zone
  catalog_db: Catalog DB {class: [datastore; low]}
  orders_db: Orders DB {class: [datastore; low]}
  events: Events {class: [queue; low]}
  ledger: Ledger DB {class: [datastore; low]}
}
web -> gateway: {class: dep}
gateway -> services: routes {class: dep}
services.catalog -> data.catalog_db: {class: dep}
services.orders -> data.orders_db: {class: dep}
services.notify -> data.events: {class: dep}
services.payments -> data.ledger: {class: dep}
