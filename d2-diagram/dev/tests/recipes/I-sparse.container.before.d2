# Before: serpentine rows in a grid stretch every row to the widest one; the feedback row holds
# one node, so most of its panel is empty.
...@neutral-theme
grid-columns: 1
vertical-gap: 48
classes: {step: {width: 150; height: 92}}
index: Indexing {
  class: zone
  direction: right
  docs: Documents {class: [service; step]}
  chunk: Chunk {class: [service; step]}
  embed: Embed {class: [service; step]}
  vectors: Vector index {class: [datastore; step]}
  docs -> chunk -> embed -> vectors: {class: dep}
}
answer: Answering {
  class: zone
  direction: left
  retrieve: Retrieve {class: [service; step]}
  rerank: Rerank {class: [service; step]}
  llm: LLM answer {class: [service; step]}
  retrieve -> rerank -> llm: {class: dep}
}
feedback: Feedback {
  class: zone
  direction: right
  log: Feedback log {class: [datastore; step]}
}
index.vectors -> answer.retrieve: {class: dep}
answer.llm -> feedback.log: {class: dep}
