# Before: labels on edges that cross two container borders land on a border (and push the
# edge through the namespace title).
...@neutral-theme
direction: down
users: Shoppers {class: actor}
alb: "Load balancer\nAWS ALB" {class: service}
eks: EKS cluster {
  class: zone
  shop: namespace shop {
    class: zone-blue
    api: "orders-api\n3 pods" {class: [service; focal]; style.multiple: true}
    web: "storefront\n3 pods" {class: service; style.multiple: true}
  }
}
users -> alb: "HTTPS :443" {class: flow}
alb -> eks.shop.api: ":8080" {class: flow}
alb -> eks.shop.web: ":8080" {class: dep}
