# After: the request's three stages (order, warehouse, delivery) become the three rows of a
# serpentine grid, each running its own direction: the column fills instead of one narrow tower.
...@neutral-theme
classes: {step: {width: 140}}
grid-columns: 1
vertical-gap: 60

order: Order {
  class: zone
  direction: right
  receive: Receive order {class: [service; step]}
  validate: Validate {class: [service; step]}
  charge: Charge card {class: [service; step]}
  receive -> validate -> charge: {class: dep}
}
warehouse: Warehouse {
  class: zone
  direction: left
  reserve: Reserve stock {class: [service; step]}
  pick: Pick {class: [service; step]}
  pack: Pack {class: [service; step]}
  reserve -> pick -> pack: {class: dep}
}
deliver: Delivery {
  class: zone
  direction: right
  print: Print label {class: [service; step]}
  ship: Ship {class: [service; step]}
  notify: Notify buyer {class: [service; step]}
  print -> ship -> notify: {class: dep}
}
order.charge -> warehouse.reserve: {class: dep}
warehouse.pack -> deliver.print: {class: dep}
