# request: "The web app calls the Orders API, which writes orders to Postgres and
#  publishes order events to Kafka. Highlight the Orders API."
# the user confirmed: a mailer consumes the order events
type: architecture
reader: team wiki
width: 800
direction: down
focus: api
out: auth, monitoring
nodes:
  web: Web app
  api: Orders API
  db: Orders DB\nPostgres {shape: cylinder}
  events: Order events\nKafka
  mailer: Mailer
edges:
  web -> api: HTTPS
  api -> db
  api -> events {dashed}
  events -> mailer {dashed}
