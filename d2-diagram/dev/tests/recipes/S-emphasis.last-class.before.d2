# Before: class [focal; service]: the last class wins, so service repaints the focus white.
# brief: arch.brief
...@neutral-theme
direction: down
web: Web app {class: actor}
api: Orders API {class: [focal; service]}
db: "Orders DB\nPostgres" {class: datastore}
events: "Order events\nKafka" {class: queue}
mailer: Mailer {class: service}
web -> api: HTTPS {class: flow}
api -> db: {class: dep}
api -> events: {class: async}
events -> mailer: {class: async}
