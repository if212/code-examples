# After: the height the finding suggests, set once for every cell through a class.
# allow: W-aspect
...@neutral-theme
classes: {cell: {height: 165}}
grid-columns: 3
horizontal-gap: 40
api: "Orders API\nGo" {class: [service; cell]; icon: icons/server.svg}
db: "Orders DB\nPostgres" {class: [service; cell]; icon: icons/database.svg}
mail: "Mailer\nSendGrid" {class: [service; cell]; icon: icons/mail.svg}
