# After: the store is declared in the same zone as the node that uses it, so ELK places it
# beside its partner.
# allow: W-sibling-size (the store beside the worker is a cylinder, taller than a one-line box)
...@neutral-theme
direction: down
ns: Orders namespace {
  class: zone
  web: Web {class: service}
  api: API {class: service}
  worker: Worker {class: service}
  jobs: Jobs {class: service}
  pg: "Sessions DB\nPostgres" {class: datastore}
  web -> api: {class: dep}
  api -> worker: {class: dep}
  worker -> jobs: {class: dep}
  web -> pg: SQL {class: dep}
}
