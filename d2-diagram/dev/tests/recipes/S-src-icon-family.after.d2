# After: one family (lucide) for every icon; the product name stays in the label.
# brief: arch.brief
...@neutral-theme
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    a -> b: call or write {class: dep}
    a -> b: event, async {class: async}
  }
}
direction: right
classes: {tier: {width: 176}; ico: {width: 120; height: 96}}
web: Web app {class: [actor; ico]; icon: icons/app-window.svg}
api: Orders API {class: [service; ico; focal]; icon: icons/server.svg}
db: "Orders DB\nPostgres" {class: [datastore; tier]}
events: "Order events\nKafka" {class: [queue; tier]}
mailer: Mailer {class: [service; ico]; icon: icons/mail.svg}
web -> api: HTTPS {class: dep}
api -> db: {class: dep}
api -> events: {class: async}
events -> mailer: {class: async}
