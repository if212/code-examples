# Before: the decision inside the rollback scope has its own reject edge beside the scope's
# failure edge: ELK centres the spine between them, and the main path drifts sideways.
...@neutral-theme
direction: down

pr: Pull request opened {class: terminal}
checks: Checks run in parallel {
  class: zone
  lint: Lint {class: service}
  unit: Unit tests {class: service}
  build: Build {class: service}
}
scan: Security scan {class: service}
staging: Deploy to staging {class: service}
release: "After staging: any failure rolls back" {
  class: boundary
  e2e: Run e2e tests {class: service}
  approval: "Manual approval?" {class: [decision; focal]}
  canary: "Production canary at 10%" {class: service}
  rollout: Full rollout {class: [success; terminal]}
}
rollback: Roll back release {class: [danger; terminal]}

# Happy path first, as flow. Only decision branches carry labels.
pr -> checks: {class: flow}
checks -> scan: {class: flow}
scan -> staging: {class: flow}
staging -> release: {class: flow}
release.e2e -> release.approval: {class: flow}
release.approval -> release.canary: approved {class: flow}
release.canary -> release.rollout: {class: ok}

# One side lane: every failure after staging ends in the rollback.
release.approval -> rollback: rejected {class: failure}
release -> rollback: {class: failure}
