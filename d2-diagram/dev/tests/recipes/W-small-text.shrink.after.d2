# After: the E-small-text levers (direction down, \n wraps) bring the canvas under the column:
# scale 1. One width class per tier, and a gateway as wide as the tier it feeds.
# column: 1000
...@neutral-theme
direction: down
classes: {tier: {width: 190}}

web: Web storefront {class: actor}
gateway: API gateway {class: service; width: 610}
billing: "Billing and\ninvoicing service" {class: [service; tier]}
orders: "Order management\nservice" {class: [service; tier]}
search: "Product search\nservice" {class: [service; tier]}
ledger: "Ledger database\nPostgres" {class: [datastore; tier]}
db: "Orders database\nPostgres" {class: [datastore; tier]}
index: "Search index\nOpenSearch" {class: [datastore; tier]}

web -> gateway: HTTPS {class: dep}
gateway -> billing: REST {class: dep}
gateway -> orders: REST {class: dep}
gateway -> search: REST {class: dep}
billing -> ledger: posts entries {class: dep}
orders -> db: writes orders {class: dep}
search -> index: queries {class: dep}
