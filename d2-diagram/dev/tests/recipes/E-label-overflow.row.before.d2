# Before: a compare panel keeps one width class (120) for every box; the tech line "no map for
# fixer lines" is 21 characters, and d2 fits lines 2+ at the title size (16px) too: the label is
# pushed out under its box.
...@neutral-theme
direction: down
classes: {box: {width: 120}}
json: "analysis.json\nrow e.g. 109" {class: [service; tech; box]}
map: "git-diff map\nno map for fixer lines" {class: [service; tech; box]}
gate: "Gate\nreads the row" {class: [service; tech; box]}
json -> map: {class: dep}
map -> gate: {class: dep}
