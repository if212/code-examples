# After: the same edge written consumer <- broker keeps ELK's rank order: a short hop up.
...@neutral-theme
direction: down
web: Web app {class: actor}
services: Services {
  class: zone
  orders: Orders {class: [service; focal]}
  notify: Notifications {class: service}
}
data: Data {
  class: zone
  db: "Orders DB\nPostgres" {class: datastore}
  events: "Order events\nKafka" {class: queue}
}
web -> services.orders: {class: flow}
services.orders -> data.db: {class: dep}
services.orders -> data.events: {class: async}
services.notify <- data.events: {class: async}
