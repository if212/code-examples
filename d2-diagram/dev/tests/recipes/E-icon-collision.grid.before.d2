# Before: grid cells are not grown to fit an icon: the two-line label runs into it.
...@neutral-theme
grid-columns: 3
horizontal-gap: 40
api: "Orders API\nGo" {class: service; icon: icons/server.svg}
db: "Orders DB\nPostgres" {class: service; icon: icons/database.svg}
mail: "Mailer\nSendGrid" {class: service; icon: icons/mail.svg}
