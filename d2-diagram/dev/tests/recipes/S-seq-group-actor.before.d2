# Before: a key used inside the group (ap, a typo) was never declared, so the group turns into a participant.
# brief: seq.brief
# expect: S-missing-edge
...@neutral-theme
shape: sequence_diagram
app: Mobile app {class: actor}
auth: Auth server {class: [actor; focal]}
users: User store {class: actor}
app -> auth: "1. POST /login" {class: dep}
auth -> users: "2. check password" {class: dep}
users -> auth: "3. match" {class: secondary}
auth -> app: "4. 200 token" {class: secondary}
locked: "opt: locked out" {
  class: zone
  auth -> ap: "5. 429 retry later" {class: failure}
}
