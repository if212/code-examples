# After: the focus node ends its class list with focal.
# brief: arch.brief
...@neutral-theme
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    a -> b: call or write {class: dep}
    a -> b: event, async {class: async}
  }
}
direction: right
classes: {tier: {width: 180}}
web: Web app {class: actor}
api: Orders API {class: [service; focal]}
db: "Orders DB\nPostgres" {class: [datastore; tier]}
events: "Order events\nKafka" {class: [queue; tier]}
mailer: Mailer {class: service}
web -> api: HTTPS {class: dep}
api -> db: {class: dep}
api -> events: {class: async}
events -> mailer: {class: async}
