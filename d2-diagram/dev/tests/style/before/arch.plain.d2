# Same graph as ../arch.ds.d2 with no design system (built-in theme look).
vars: {d2-config: {layout-engine: elk; pad: 24}}
direction: down

web: Web app
mobile: Mobile app
vpc: Production VPC {
  orders: "Order service\nJava"
  db: Orders DB {shape: cylinder}
  bus: order-events {shape: queue}
  pay: Payment service
  worker: Fulfilment worker
}
erp: Legacy ERP
carrier: Carrier API
stripe: Stripe API

web -> vpc.orders
mobile -> vpc.orders
vpc.orders -> vpc.db: writes
vpc.orders -> vpc.bus: OrderPlaced
vpc.orders -> vpc.pay: charges
vpc.bus -> vpc.worker: consumes
vpc.db -> erp: nightly export
vpc.worker -> carrier: books shipment
vpc.pay -> stripe: HTTPS
