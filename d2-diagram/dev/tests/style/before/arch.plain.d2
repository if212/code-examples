# Same graph as ../arch.ds.d2 with no design system (built-in theme look).
vars: {d2-config: {layout-engine: elk; pad: 24}}
direction: down

clients: Clients {
  web: Web app
  mobile: Mobile app
}
vpc: Production VPC {
  gw: API gateway
  orders: Order service
  db: "Orders DB\nPostgres" {shape: cylinder}
  bus: order-events {shape: queue}
  pay: Payment service
  worker: Fulfilment worker
  dlq: Dead letters {shape: queue}
}
erp: Legacy ERP
stripe: Stripe API

clients.web -> vpc.gw: HTTPS
clients.mobile -> vpc.gw: HTTPS
vpc.gw -> vpc.orders: place order
vpc.orders -> vpc.db: write
vpc.orders -> vpc.pay: charge
vpc.orders -> vpc.bus: OrderPlaced
vpc.bus -> vpc.worker: consume
vpc.pay -> stripe: HTTPS
vpc.pay -> vpc.dlq: on failure
vpc.worker -> erp: nightly sync
