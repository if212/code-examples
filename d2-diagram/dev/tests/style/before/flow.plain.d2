# Same graph as ../flow.ds.d2 with no design system (built-in theme look).
vars: {d2-config: {layout-engine: elk; pad: 24}}
direction: down

start: Commit pushed {shape: oval}
build: Build and unit tests
ok1: Tests pass? {shape: diamond}
stage: Deploy to staging
ok2: Smoke tests OK? {shape: diamond}
approve: Manual approval
prod: Deploy to production
done: Released {shape: oval}
failed: Build failed {shape: oval}
rollback: Staging rolled back {shape: oval}

start -> build
build -> ok1
ok1 -> stage: yes
ok1 -> failed: no
stage -> ok2
ok2 -> approve: yes
ok2 -> rollback: no
approve -> prod
prod -> done
