# Architecture sample for the neutral theme (brief: web + mobile clients, one VPC,
# async fulfilment, Stripe and a legacy ERP outside). Focus: API gateway.
...@../../../templates/neutral-theme
direction: down

clients: Clients {
  class: zone
  web: Web app {class: actor}
  mobile: Mobile app {class: actor}
}
vpc: Production VPC {
  class: zone
  gw: API gateway {class: focal}
  orders: Order service {class: service}
  db: "Orders DB\nPostgres" {class: datastore}
  bus: order-events {class: queue}
  pay: Payment service {class: service}
  worker: Fulfilment worker {class: service}
  dlq: Dead letters {class: [queue; danger]}
}
erp: Legacy ERP {class: muted}
stripe: Stripe API {class: external}

clients.web -> vpc.gw: HTTPS {class: flow}
clients.mobile -> vpc.gw: HTTPS {class: dep}
vpc.gw -> vpc.orders: place order {class: flow}
vpc.orders -> vpc.db: write {class: dep}
vpc.orders -> vpc.pay: charge {class: flow}
vpc.orders -> vpc.bus: OrderPlaced {class: async}
vpc.bus -> vpc.worker: consume {class: async}
vpc.pay -> stripe: HTTPS {class: flow}
vpc.pay -> vpc.dlq: on failure {class: failure}
vpc.worker -> erp: nightly sync {class: secondary}
