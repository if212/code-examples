# Architecture sample for the neutral theme. Request it stands for: "Checkout:
# web and mobile clients call the Order service; it writes the Orders DB,
# charges Stripe through the Payment service and publishes an event that a
# fulfilment worker turns into a carrier booking; a legacy ERP gets a nightly
# export. Highlight the Order service."
# Peers look alike (web and mobile; the lower tiers share one width class);
# the one focus is the Order service, as wide as the three tiers it calls, so
# every edge drops straight; the key names each line style and outline.
...@../../../templates/neutral-theme
direction: down
vars: {
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    ext: third party {class: [service; external]}
    old: legacy (gray label) {class: muted}
    a -> b: call {class: dep}
    a -> b: event {class: async}
    a -> b: nightly batch {class: secondary}
  }
}
classes: {
  tier: {width: 176}
  row: {height: 90}
}

web: Web app {class: [actor; compact; tier]}
mobile: Mobile app {class: [actor; compact; tier]}
vpc: Production VPC {
  class: zone
  orders: "Order service\nJava" {class: [service; tech; focal]; width: 560}
  db: Orders DB {class: [datastore; tier; row]}
  bus: order-events {class: [queue; tier; row]}
  pay: Payment service {class: [service; tier; row]}
  worker: Fulfilment worker {class: [service; compact; tier]}
}
erp: Legacy ERP {class: [muted; compact; tier]}
carrier: Carrier API {class: [service; compact; tier; external]}
stripe: Stripe API {class: [service; compact; tier; external]}

web -> vpc.orders: {class: dep}
mobile -> vpc.orders: {class: dep}
vpc.orders -> vpc.db: writes {class: dep}
vpc.orders -> vpc.bus: OrderPlaced {class: async}
vpc.orders -> vpc.pay: charges {class: dep}
vpc.bus -> vpc.worker: consumes {class: async}
vpc.db -> erp: nightly export {class: secondary}
vpc.worker -> carrier: books shipment {class: dep}
vpc.pay -> stripe: HTTPS {class: dep}
