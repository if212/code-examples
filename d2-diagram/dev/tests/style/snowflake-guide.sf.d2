# Style guide for templates/snowflake-brand.d2: every sf-* class, rendered.
# A real diagram uses at most ONE sf-accent-*; this sheet shows all four.
# Render: sh scripts/d2check.sh dev/tests/style/snowflake-guide.sf.d2 OUT.svg
...@../../../templates/snowflake-brand
direction: down
grid-columns: 1
grid-gap: 24

title: "Style guide: snowflake-brand" {class: title}

nodes: Node roles {
  class: sf-container
  grid-rows: 2
  horizontal-gap: 24
  vertical-gap: 24
  node: sf-node {class: sf-node}
  actor: sf-actor {class: sf-actor}
  primary: sf-primary {class: sf-primary}
  store: sf-datastore {class: sf-datastore}
  ext: sf-external {class: sf-external}
  muted: sf-muted {class: sf-muted}
}

accents: Accents (one per diagram) {
  class: sf-container
  orange: sf-accent-orange {class: sf-accent-orange}
  star: sf-accent-star {class: sf-accent-star}
  pink: sf-accent-pink {class: sf-accent-pink}
  purple: sf-accent-purple {class: sf-accent-purple}
}

edges: Edge roles {
  class: sf-container
  a1: A {class: sf-node}
  b1: B {class: sf-node}
  a2: A {class: sf-node}
  b2: B {class: sf-node}
  a3: A {class: sf-node}
  b3: B {class: sf-node}
  a1 -> b1: sf-edge {class: sf-edge}
  a2 -> b2: sf-flow {class: sf-flow}
  a3 -> b3: sf-failure {class: sf-failure}
}

geometry: Geometry classes (as in neutral-theme) {
  class: sf-container
  compact: compact {class: [sf-node; compact]}
  tech: "tech\nline 2 is 14px gray" {class: [sf-node; tech]}
  key: {
    class: key
    chip: chip {class: [sf-node; chip]}
    retired: retired {class: [sf-node; chip; sf-muted]}
  }
}

ghosts: "ghost: an invisible third child keeps the main path straight" {
  class: sf-container
  fork: fork {class: [sf-node; compact]}
  g: "" {class: ghost}
  main: main {class: [sf-node; compact]}
  exit: exit {class: [sf-node; compact]}
  fork -> g: exit {class: ghost}
  fork -> main: next {class: sf-edge}
  fork -> exit: exit {class: sf-edge}
}

snippet: "Code classes (playbooks/code.md)" {
  class: sf-container
  grid-rows: 2
  vertical-gap: 16
  card: "routes/orders.ts" {
    class: code-file
    src: |`ts
      const order = await repo.find(id); // <1>
      if (!order) return notFound();
    `| {class: code}
  }
  notes: {
    class: callouts
    n1: "1. One read, by primary key" {class: callout}
  }
}
