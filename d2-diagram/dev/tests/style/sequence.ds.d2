# Sequence sample for the neutral theme: participants use `actor` (light chrome,
# so the messages are the heaviest ink), returns `secondary`, the one note is
# [note; compact]. Request it stands for: "Login: the SPA posts credentials,
# the gateway asks the auth server to verify them and returns a token; show
# the refresh when the token expired." The login chain it writes is the flow.
...@../../../templates/neutral-theme
shape: sequence_diagram
classes: {
  p: {width: 150}
}

spa: Browser SPA {class: [actor; p]}
api: API gateway {class: [actor; p]}
auth: Auth server {class: [actor; p]}

spa -> api: POST /login {class: flow}
api -> auth: verify(credentials) {class: flow}
auth."bcrypt compare, 15 min JWT": {class: [note; compact]}
auth -> api: signed JWT {class: secondary}
api -> spa: 200 OK + token {class: flow}
refresh: "alt: token expired" {
  class: zone
  spa -> api: POST /refresh {class: dep}
  api -> spa: 200 OK + new token {class: secondary}
}
