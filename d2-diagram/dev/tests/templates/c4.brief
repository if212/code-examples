# request: "C4 container diagram of the online shop for the architecture doc. Customers
#  use the React web app, staff use the React admin app; both call the Go API over
#  JSON/HTTPS. The API reads and writes the Postgres database and queues payment and
#  receipt jobs (AMQP) for a Go worker, which charges cards through Stripe. Focus on
#  the API."
type: c4
reader: architecture doc
width: 800
direction: down
focus: shop.api  # "Focus on the API"
out: context and component levels, deployment details, element descriptions (not given)
nodes:
  customer: Customer\n[Person] {shape: c4-person}
  staff: Staff\n[Person] {shape: c4-person}
  stripe: Stripe\n[Software System] {external}
  shop: Online shop [Software System]
  shop.web: Web app\n[Container: React]
  shop.admin: Admin app\n[Container: React]
  shop.worker: Worker\n[Container: Go]
  shop.api: API\n[Container: Go]
  shop.db: Database\n[Container: Postgres] {shape: cylinder}
edges:
  customer -> shop.web: Uses [HTTPS]
  staff -> shop.admin: Uses [HTTPS]
  shop.web -> shop.api: Calls [JSON/HTTPS]
  shop.admin -> shop.api: Calls [JSON/HTTPS]
  shop.api -> shop.worker: Queues jobs [AMQP]
  shop.worker -> stripe: Charges cards [HTTPS]
  shop.api -> shop.db: Reads, writes [SQL]
