# request: "UML class diagram of the checkout domain for the payments design
#  doc. An Order (id, total(), checkout()) is composed of one or more LineItems
#  (sku, qty) and pays with at most one PaymentMethod. PaymentMethod is an
#  interface with charge(amount); CardPayment and Wallet implement it.
#  Focus on Order."
type: class
reader: engineers reading the payments design doc
width: 800
direction: down
focus: Order  # "Focus on Order"
out: refunds, currency conversion
nodes:
  Order: Order {fields: id total() checkout()}
  LineItem: LineItem {fields: sku qty}
  PaymentMethod: "<<interface>> PaymentMethod" {fields: charge(amount)}
  CardPayment: CardPayment {fields: token}
  Wallet: Wallet {fields: balance}
edges:
  Order <- LineItem: contains {src: diamond-filled, dst-label: 1..*}
  Order -> PaymentMethod: pays with {dst-label: 0..1}
  PaymentMethod <- CardPayment {src: triangle-hollow, dashed}
  PaymentMethod <- Wallet {src: triangle-hollow, dashed}
