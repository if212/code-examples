# request: "State machine of an order for the orders README: pending -> paid ->
#  shipped -> delivered. A pending order can be cancelled, a paid order can be
#  refunded, and a shipped order can be returned. Delivered, cancelled, refunded
#  and returned are final. Mark the start and the final states."
type: state
reader: engineers reading the orders README
width: 800
direction: down
focus: start -> pending -> paid -> shipped -> delivered  # "pending -> paid -> shipped -> delivered"
out: payment failure, partial refunds, the refund after a return
nodes:
  start: "" {start}
  pending: Pending
  paid: Paid
  shipped: Shipped
  delivered: Delivered {end}
  cancelled: Cancelled {end}
  refunded: Refunded {end}
  returned: Returned {end}
transitions:
  start -> pending
  pending -> paid: pay
  paid -> shipped: ship
  shipped -> delivered: deliver
  pending -> cancelled: cancel
  paid -> refunded: refund
  shipped -> returned: return
