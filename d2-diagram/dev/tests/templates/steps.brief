# request: "Postgres failover for the ops runbook, one board per step, same layout on
#  every board: 1) the orders service queries through PgBouncer, which sends writes
#  to the primary and reads to the replica; 2) the primary fails; 3) the replica is
#  promoted and PgBouncer sends writes and reads to it. Highlight what changes."
type: steps
reader: on-call engineers reading the ops runbook (one image per step)
width: 800
direction: down
focus: none
# what changes is marked on its own board by outcome (danger and failure, then success and ok)
out: the promotion mechanism (Patroni), replication lag, DNS
nodes:
  app: Orders service
  proxy: Pooler\nPgBouncer
  primary: Primary\nPostgres {shape: cylinder}
  replica: * {shape: cylinder}
  status: * {note}
edges:
  app -> proxy: queries
  proxy -> primary: writes
  proxy -> replica: *
