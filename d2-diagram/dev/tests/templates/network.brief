# request: "Network diagram of the prod VPC (10.0.0.0/16, us-east-1) for the
#  platform runbook. Two AZs, each with a public, a private and a data subnet.
#  Internet users reach an ALB in the public subnets over HTTPS 443 through the
#  internet gateway; the ALB forwards to orders-api on 8080, running as
#  Fargate tasks in the private subnets. orders-api talks to Postgres (5432,
#  primary in 1a, standby in 1b), the workers to Redis (6379, primary and
#  replica); the workers reach the internet through a NAT gateway per AZ."
type: network
reader: platform engineers reading the runbook
width: 800
direction: down
focus: users -> vpc.igw -> vpc.pub_a.alb -> vpc.app_a.api
out: AZ frames (each subnet title names its AZ), route tables, NACLs, security groups, VPC endpoints, DNS
nodes:
  users: Internet users
  vpc: VPC 10.0.0.0/16, us-east-1
  vpc.igw: Internet gateway
  vpc.pub_a: Public 1a\n10.0.1.0/24
  vpc.pub_a.alb: ALB\nnode 1a
  vpc.pub_a.nat: NAT\ngateway 1a
  vpc.pub_b: Public 1b\n10.0.2.0/24
  vpc.pub_b.alb: ALB\nnode 1b
  vpc.pub_b.nat: NAT\ngateway 1b
  vpc.app_a: Private 1a\n10.0.11.0/24
  vpc.app_a.api: orders-api\nFargate 1a
  vpc.app_a.worker: worker\nFargate 1a
  vpc.app_b: Private 1b\n10.0.12.0/24
  vpc.app_b.api: orders-api\nFargate 1b
  vpc.app_b.worker: worker\nFargate 1b
  vpc.data_a: Data 1a\n10.0.21.0/24
  vpc.data_a.db: Postgres\nprimary {shape: cylinder}
  vpc.data_a.cache: Redis\nprimary {shape: cylinder}
  vpc.data_b: Data 1b\n10.0.22.0/24
  vpc.data_b.db: Postgres\nstandby {shape: cylinder}
  vpc.data_b.cache: Redis\nreplica {shape: cylinder}
edges:
  users -> vpc.igw: "HTTPS :443"
  vpc.igw -> vpc.pub_a.alb: ":443"
  vpc.igw -> vpc.pub_b.alb: ":443"
  vpc.pub_a.alb -> vpc.app_a.api: ":8080"
  vpc.pub_b.alb -> vpc.app_b.api: ":8080"
  vpc.app_a.api -> vpc.data_a.db: ":5432"
  vpc.app_b.api -> vpc.data_b.db: ":5432"
  vpc.app_a.worker -> vpc.data_a.cache: ":6379"
  vpc.app_b.worker -> vpc.data_b.cache: ":6379"
  vpc.app_a.worker -> vpc.pub_a.nat: egress {dashed}
  vpc.app_b.worker -> vpc.pub_b.nat: egress {dashed}
  vpc.pub_a.nat -> vpc.igw: egress {dashed}
  vpc.pub_b.nat -> vpc.igw: egress {dashed}
