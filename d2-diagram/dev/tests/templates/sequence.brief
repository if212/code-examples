# request: "Sequence diagram of our checkout for the design doc. The browser posts
#  the order to the Orders API, which saves it as pending in the Orders DB and
#  charges the card through Stripe. Approved: mark the order paid and return
#  201. Declined: mark it failed and return 402. Focus on the Orders API."
type: sequence
reader: engineers reading a design doc (Markdown)
width: 800
direction: down
focus: api  # "Focus on the Orders API"
out: refunds, 3-D Secure, webhooks, Stripe's reply (the guards name it)
nodes:
  browser: Browser
  api: Orders API
  db: Orders DB
  psp: Stripe
  alt: "alt: charge result" {group}
  alt.ok: "[approved]" {group}
  alt.declined: "[declined]" {group}
messages:
  browser -> api: "1. POST /orders"
  api -> db: "2. INSERT order (pending)"
  api -> psp: "3. POST /charges"
  api -> db: "4. UPDATE order (paid)" {in: alt.ok}
  api -> browser: "5. 201 Created" {return, in: alt.ok}
  api -> db: "4. UPDATE order (failed)" {in: alt.declined}
  api -> browser: "5. 402 Payment Required" {return, in: alt.declined}
