# request: "Data pipeline for the analytics README: the Postgres app DB, the Stripe API
#  and Segment clickstream are loaded by Fivetran into Snowflake RAW; dbt builds
#  STAGING and then MARTS; MARTS feed Looker dashboards, Feast features and Hightouch
#  reverse ETL. Highlight MARTS."
type: pipeline
reader: analytics README
width: 800
direction: down   # stage zones stack down; the warehouse layers inside Snowflake
focus: wh.marts  # "Highlight MARTS"
out: orchestration (Airflow), monitoring, access control
nodes:
  sources: Sources
  sources.pg: App DB\nPostgres {shape: cylinder}
  sources.stripe: Payments\nStripe API
  sources.events: Clickstream\nSegment
  wh: Snowflake
  wh.raw: RAW {shape: cylinder}
  wh.stg: STAGING {shape: cylinder}
  wh.marts: MARTS {shape: cylinder}
  consumers: Consumers
  consumers.bi: Dashboards\nLooker
  consumers.ml: Features\nFeast
  consumers.retl: Reverse ETL\nHightouch
edges:
  sources.pg -> wh.raw: Fivetran
  sources.stripe -> wh.raw: Fivetran
  sources.events -> wh.raw: Fivetran
  wh.raw -> wh.stg: dbt
  wh.stg -> wh.marts: dbt
  wh.marts -> consumers.bi
  wh.marts -> consumers.ml
  wh.marts -> consumers.retl
