vars: {
  d2-config: {layout-engine: elk}
  d2-legend: {
    a: {style.opacity: 0}
    b: {style.opacity: 0}
    a <-> b: one to many {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-many}
  }
}
direction: right
users: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  email: text {constraint: unique}
}
tasks: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  assignee_id: uuid {constraint: foreign_key}
  title: text
}
tasks.assignee_id <-> users.id: assigned to {
  source-arrowhead.shape: cf-many
  target-arrowhead.shape: cf-one-required
}
