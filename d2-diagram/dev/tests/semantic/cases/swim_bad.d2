# a decision exit without a label fails S-decision on a swimlane too
...@mini-theme
direction: right
cust: Customer {
  class: zone
  ask: Ask for a refund {class: terminal}
}
sup: Support {
  class: zone
  check: Over 100 USD? {class: decision}
  pay: Refund paid {class: terminal}
}
mgr: Manager {
  class: zone
  ok: Approve {class: service}
}
cust.ask -> sup.check: {class: dep}
sup.check -> sup.pay: no {class: dep}
sup.check -> mgr.ok: {class: dep}
mgr.ok -> sup.pay: {class: dep}
