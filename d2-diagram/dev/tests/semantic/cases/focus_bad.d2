...@mini-theme
direction: down
web: Web app {class: actor}
api: Backend {
  class: zone
  gw: API gateway {class: focal}
  orders: Order service {class: service}
  db: "Orders DB\nPostgres" {class: datastore}
}
web -> api.gw: HTTPS {class: flow}
api.gw -> api.orders: forwards {class: dep}
api.orders -> api.db: stores orders {class: dep}
