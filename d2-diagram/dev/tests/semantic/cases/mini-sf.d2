# minimal stand-in for snowflake-brand.d2
vars: {d2-config: {layout-engine: elk; pad: 24}}
classes: {
  sf-node: {style: {fill: "#FFFFFF"; stroke: "#11567F"}}
  sf-actor: {style: {fill: "#FFFFFF"; stroke: "#BCE3F7"; bold: true}}
  sf-primary: {style: {fill: "#29B5E8"}}
  sf-datastore: {shape: cylinder}
  sf-edge: {style.stroke: "#11567F"}
  sf-flow: {style: {stroke: "#11567F"; stroke-width: 3}}
}
