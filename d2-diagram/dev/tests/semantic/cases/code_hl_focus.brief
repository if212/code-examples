# request: "For the PR description: show list_orders.sql and highlight the keyset
#  condition that replaced OFFSET."
type: code-annotated
reader: reviewers of the paging PR
width: 800
direction: down
focus: q  # "highlight the keyset condition"
out: the old query
nodes:
  q: queries/list_orders.sql
  q.src: * {code}   # queries/list_orders.sql in the PR
edges:
