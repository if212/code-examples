...@mini-theme
vars: {
  d2-legend: {
    h1: {style.opacity: 0}
    h2: {style.opacity: 0}
    h1 -> h2: happy path {class: flow}
    h1 -> h2: fails {class: failure}
  }
}
direction: down
start: "" {class: dot}
queued: Queued {class: service}
active: In progress {
  class: zone
  building: Building {class: service}
  deploying: Deploying {class: focal}
}
live: Live {class: terminal}
failed: Failed {class: terminal}
start -> queued: {class: flow}
queued -> active.building: runner free {class: flow}
active.building -> active.deploying: build passes {class: flow}
active.deploying -> live: checks pass {class: flow}
active -> failed: any step fails {class: failure}
