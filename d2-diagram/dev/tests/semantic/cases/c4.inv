# request: "C4 container view of the Shop: a customer uses the web app over HTTPS;
#  the web app calls the Go API (JSON/HTTPS); the API reads/writes Postgres and
#  sends email through the external Email System over SMTP."
type: c4
layout: elk
nodes:
  customer: "Customer [Person] Buys things online" {shape: c4-person}
  shop: Shop System [Software System]
  shop.web: "Web App [Container: React] Serves the storefront"
  shop.api: "API [Container: Go]"
  shop.db: "Database [Container: Postgres]" {shape: cylinder}
  mail: "Email System [Software System]" {external}
edges:
  customer -> shop.web: "Uses [HTTPS]"
  shop.web -> shop.api: "Calls [JSON/HTTPS]"
  shop.api -> shop.db: "Reads/writes [SQL/TCP]"
  shop.api -> mail: "Sends email [SMTP]"
