# request: "The checkout service reads prices from the catalog and caches them
#   in Redis. Payments go through Stripe."
type: architecture
reader: test
width: 800
direction: down
focus: checkout  # "The checkout service reads prices"
out: -
nodes:
  checkout: Checkout service
  catalog: Catalog
  stripe: Stripe {external}
edges:
  checkout -> catalog: reads prices
  checkout -> stripe: pays
