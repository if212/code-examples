# code-compare: the diff markers swapped sides - <+> on the before block (left), <-> on the after (S-code-marker)
...@mini-theme
grid-rows: 2
grid-columns: 2
horizontal-gap: 16
vertical-gap: 8
h1: Before {shape: text}
h2: After {shape: text}
before: |`sql
  SELECT id, total FROM orders
  ORDER BY id
  LIMIT 50 OFFSET 100000; -- <+>
`| {class: code}
after: |`sql
  SELECT id, total FROM orders
  WHERE id > $1 -- <->
  ORDER BY id
  LIMIT 50; -- <->
`| {class: code}
