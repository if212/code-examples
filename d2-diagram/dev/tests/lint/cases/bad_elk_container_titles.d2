# flags: -l elk --pad 24
# expect: E-edge-through-label
# elk + direction: down: edges entering a container at top-center strike through its centred title
direction: down
users: Users {shape: person}
edge: Edge {
  cdn: CDN {icon: ./cloud.svg}
  waf: WAF {icon: ./lock.svg}
  cdn -> waf
}
app: Application {
  api: API Gateway {icon: ./server.svg}
  auth: Auth Service
  orders: Orders Service
  api -> auth: verify token
  api -> orders: REST
}
data: Data {
  pg: Postgres {shape: cylinder; icon: ./database.svg}
  cache: Redis {shape: cylinder}
}
users -> edge.cdn: HTTPS
edge.waf -> app.api
app.orders -> data.pg: SQL
app.orders -> data.cache: read-through
