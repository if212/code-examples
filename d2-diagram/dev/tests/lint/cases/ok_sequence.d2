# expect-clean: E- W-
# post: svgpost
# A small sequence with a note and a group, finished the way d2check finishes it: the group title
# moves off the gateway lifeline (svgpost), and the whole fits the doc budget (<= 1000px, aspect >= 0.6).
shape: sequence_diagram
client
gateway
service
db
client -> gateway: request
service -> db: query
service."cache miss"
service -> gateway: response
g: retry block {
  gateway -> service: retry
}
gateway -> client: ok
