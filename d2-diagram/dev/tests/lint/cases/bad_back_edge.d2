# expect: W-long-edge
# expect-clean: E-
# expect-text: back-edge detour
# the consumer sits in the upper row: its broker's edge runs against the reading direction, around the diagram
vars: {d2-config: {layout-engine: elk; pad: 24}}
direction: down
web: Web app
services: Services {
  orders: Orders
  notify: Notifications
}
data: Data {
  db: Orders DB {shape: cylinder}
  events: Order events {shape: queue}
}
web -> services.orders
services.orders -> data.db
services.orders -> data.events
data.events -> services.notify
