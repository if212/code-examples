# post: svgpost
# expect-clean: E- W-label-on-bend
# A copy of the round-4 state template: d2 ends the 'refund' and 'return' labels right where the 10px
# corner arc of their elbow begins (the text runs into the curve, 0-4px from it); svgpost moves every
# label within 14px of a corner onto bare line (test_svgpost.sh).
...@neutral-theme
direction: down

# One width for every state, one height (compact): the spine comes out even.
classes: {box: {width: 140}}

# The initial state is a dot with no label. States are named as conditions.
start: "" {class: dot}
pending: Pending {class: [state; compact; box]}
paid: Paid {class: [state; compact; box]}
shipped: Shipped {class: [state; compact; box]}
# Final states: terminal + double border. A good end is success, a bad end
# danger; a neutral end stays a plain, full-weight pill.
delivered: Delivered {class: [success; compact; box; terminal]; style.double-border: true}
cancelled: Cancelled {class: [compact; box; terminal]; style.double-border: true}
refunded: Refunded {class: [compact; box; terminal]; style.double-border: true}
returned: Returned {class: [compact; box; terminal]; style.double-border: true}
# A state with a side exit gets a ghost on the far side, its edge labelled
# like the real one: the main path is then the middle branch and stays straight.
g1: "" {class: ghost}
g2: "" {class: ghost}
g3: "" {class: ghost}

# Main path first, as flow; labels are the events that fire a transition.
# Side exits dep, in the order they happen: one column on the right, each
# final one rank below the state it leaves.
start -> pending: {class: flow}
pending -> g1: pay {class: ghost}
pending -> paid: pay {class: flow}
pending -> cancelled: cancel {class: dep}
paid -> g2: ship {class: ghost}
paid -> shipped: ship {class: flow}
paid -> refunded: refund {class: dep}
shipped -> g3: deliver {class: ghost}
shipped -> delivered: deliver {class: flow}
shipped -> returned: return {class: dep}

# The key: the start dot and the final state (the request asks to mark them),
# then one line per transition class, in the real classes. Short names keep
# it narrow.
vars: {
  d2-legend: {
    a: {class: ghost}
    b: {class: ghost}
    s: start {class: dot}
    f: final state {class: [compact; box; terminal]; style.double-border: true}
    a -> b: main path {class: flow}
    a -> b: side exit {class: dep}
  }
}
